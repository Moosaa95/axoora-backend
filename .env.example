# Django Secret Key
SECRET_KEY=django-insecure-axoora-super-secret-key-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app,.axoora.ai

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://axoora.ai

# Database (defaults to SQLite if not provided)
# DATABASE_URL=postgres://user:password@localhost:5432/axoora_db

# RAG & LLM Engine (Optional: Google Gemini or OpenAI)
# If omitted, Axoora uses its built-in offline hybrid RAG engine automatically.
GEMINI_API_KEY=
OPENAI_API_KEY=

